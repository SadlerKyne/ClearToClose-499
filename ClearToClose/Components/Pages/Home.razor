@page "/"
@using System.Security.Claims
@using ClearToClose.Services
@inject DashboardService DashboardService

<PageTitle>ClearToClose</PageTitle>

<h1>ClearToClose</h1>

<p>Track your income, bills and debts, and see your debt-to-income ratio before you talk to a lender.</p>

@if (summary is not null && summary.IsEmpty)
{
    <div class="card dashboard-empty">
        <div class="card-body">
            <h2 class="h5">Get started</h2>
            <p>Add your income and bills to see your monthly totals and DTI.</p>
            <a href="income" class="btn btn-primary">Add income</a>
            <a href="bills" class="btn btn-outline-primary ms-2">Add bills</a>
        </div>
    </div>
}
else if (summary is not null)
{
    <div class="dashboard-cards">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="dashboard-label">Monthly income</div>
                <div class="dashboard-value">@summary.Income.ToString("C")</div>
            </div>
        </div>
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="dashboard-label">Monthly bills</div>
                <div class="dashboard-value">@summary.Bills.ToString("C")</div>
            </div>
        </div>
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="dashboard-label">Money left after bills</div>
                <div class="dashboard-value @(summary.MoneyLeft < 0 ? "dashboard-negative" : "")">@summary.MoneyLeft.ToString("C")</div>
            </div>
        </div>
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="dashboard-label">Debt-to-income (DTI)</div>
                <div class="dashboard-value">@(summary.DtiPercent is null ? "--" : $"{summary.DtiPercent}%")</div>
                <span class="dti-badge @DtiCalculator.StatusClass(summary.DtiPercent)">@DtiCalculator.Status(summary.DtiPercent)</span>
            </div>
        </div>
    </div>

    <p class="dashboard-note">Ready is a DTI of @DtiCalculator.ReadyLimit% or less. Close is up to @DtiCalculator.CloseLimit%. Over that is Not Yet.</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private DashboardSummary? summary;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        summary = await DashboardService.GetSummaryAsync(userId);
    }
}
